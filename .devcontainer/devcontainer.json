{
  "name": "Quarto",
  "image": "rocker/tidyverse:latest",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1.1.5": {},
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "REditorSupport.r",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "mechatroner.rainbow-csv"
      ],
      "settings": {
        "quarto.render.onSave": true
      }
    }
  }
}
