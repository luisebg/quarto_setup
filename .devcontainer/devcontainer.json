{
  "name": "Quarto PPD",
  "image": "ghcr.io/mcanouil/quarto-codespaces:latest",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "mcanouil.quarto-wizard"
      ]
    },
    "codespaces": {
      "openFiles": [
        "exercises/intro-to-quarto.qmd",
        "exercises/computation.qmd"
      ]
    }
  },
  "postCreateCommand": "Rscript -e 'install.packages(c(\"tidyverse\", \"rio\", \"haven\", \"knitr\", \"DT\", \"huxtable\", \"lmtest\", \"sandwich\"), repos=\"https://cloud.r-project.org\")'"
}
